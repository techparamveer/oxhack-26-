// Copy to Config/Secrets.xcconfig (git-ignored) and paste your key from https://aistudio.google.com/apikey
// Without a key every Gemini call uses its hardcoded fallback, so the whole app still works offline.
GEMINI_API_KEY =
// Optional: override the Gemini model. Default (in code) is the rolling Flash alias.
// GEMINI_MODEL = gemini-flash-latest
// Supabase backend: Gemini proxy Edge Function (the key lives in a Supabase secret) + background sync.
// Bare host only — xcconfig treats `//` as a comment, so never paste the https:// URL here.
// Leave empty to run fully offline (direct key above, else hardcoded fallbacks).
SUPABASE_HOST = wfrlvenjytnowvjuzgom.supabase.co
// Publishable key (sb_publishable_…) or legacy anon key from Project Settings → API Keys. Never the secret key.
SUPABASE_ANON_KEY =
